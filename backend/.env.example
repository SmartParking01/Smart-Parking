# Copia este archivo como ".env" y ajusta los valores. NUNCA subas el .env real a git.

PORT=4000

# --- Conexión a PostgreSQL ---
# Opción A: una sola cadena de conexión (típico en Render/Railway/Supabase/etc.)
# Si defines DATABASE_URL, se usa esta y se ignoran las variables PG* de abajo.
# DATABASE_URL=postgresql://usuario:password@host:5432/smartparking

# Opción B: variables sueltas (típico para una instalación local de PostgreSQL)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=smartparking

# Pon en "true" si tu proveedor de PostgreSQL exige SSL (varios hosting en la nube lo requieren)
PGSSL=false

# Secreto para firmar los JWT de sesión (usa una cadena larga y aleatoria en producción)
JWT_SECRET=cambia_este_valor_por_uno_muy_seguro
JWT_EXPIRES_IN=8h

# Secreto separado para firmar el contenido del QR (no debe ser el mismo que JWT_SECRET)
QR_SECRET=cambia_este_valor_tambien_por_uno_distinto

# Minutos que una reserva permanece vigente antes de expirar si no se usa
RESERVATION_TTL_MINUTES=30
